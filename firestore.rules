rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    match /categories/{categoryId} {
      allow read, write: if isValidId(categoryId);
    }

    match /products/{productId} {
      allow read, write: if isValidId(productId);
    }

    match /customers/{customerId} {
      allow read, write: if isValidId(customerId);
    }

    match /invoices/{invoiceId} {
      allow read, write: if isValidId(invoiceId);
    }

    match /customer_transactions/{transactionId} {
      allow read, write: if isValidId(transactionId);
    }

    match /expenses/{expenseId} {
      allow read, write: if isValidId(expenseId);
    }

    match /suppliers/{supplierId} {
      allow read, write: if isValidId(supplierId);
    }

    match /roles/{roleId} {
      allow read, write: if isValidId(roleId);
    }

    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    match /audit_logs/{logId} {
      allow read, write: if isValidId(logId);
    }

    match /stock_adjustments/{adjustmentId} {
      allow read, write: if isValidId(adjustmentId);
    }

    match /test/{docId} {
      allow read, write: if isValidId(docId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
